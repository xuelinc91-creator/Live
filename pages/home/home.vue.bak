				bilibiliPlayerLoaded: false, // B站播放器是否已加载
\nttt// 视频播放状态管理 - 保证收起时后台播放ntttvideoCurrentTime: 0, // 视频当前播放时间ntttvideoPlaybackTimer: null, // 视频播放监控定时器ntttisVideoPlayingInBackground: false, // 视频是否在后台播放中
				
				// 百分数变化提示
