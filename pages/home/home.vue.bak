	.btn-text {
		font-size: 24rpx;
		color: #FFFFFF;
		font-weight: bold;
	}

	.collapsed-live-indicator {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10rpx;
		padding: 15rpx 25rpx;
		background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
