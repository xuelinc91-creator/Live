	}

	.live-text {
		font-size: 28rpx;
		color: #FFFFFF;
		font-weight: bold;
		text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.3);
	}

	.ended-icon {
		font-size: 80rpx;
